# Rinomina in .env e inserisci i valori reali.
# Questo file non va mai committato nel repository.

# Token del bot Telegram (lo ottieni da @BotFather su Telegram)
TELEGRAM_TOKEN="il_tuo_token_qui"

# Chat ID del gruppo/canale Telegram dove inviare le notifiche
# (puoi ottenere il chat_id inviando un messaggio al bot e leggendo getUpdates)
TELEGRAM_CHAT_ID="il_tuo_chat_id_qui"

# (Opzionale) Path per la pagina HTML generata
# ALERT_HTML_PATH="/var/www/init5.it/html/alert/index.html"
